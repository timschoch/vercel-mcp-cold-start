{
  "name": "@timschoch/vercel-mcp-cold-start",
  "version": "0.4.0",
  "description": "A light Vercel Function that sits in front of an MCP server on a scale-to-zero container.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timschoch/vercel-mcp-cold-start.git"
  },
  "keywords": [
    "mcp",
    "vercel",
    "cold-start",
    "json-rpc"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "hono": "^4.10.7",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "fsevents@2.3.3": true
  }
}
